# --- Discord (OAuth + bot) ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
OAUTH_REDIRECT_URI=http://localhost:5001/auth/callback

# --- VALHALLA (SPA origin + session) ---
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=your_session_secret

# --- Postgres / Supabase (storage only) ---
# Project → Connect → URI. Never commit the real value.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Storage (logo / highlights). Public bucket name: guild-assets. Never put the service role in the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Ragnarok Origin ---
# No env. Channels and game settings live on tenant_settings after onboard/setup.
