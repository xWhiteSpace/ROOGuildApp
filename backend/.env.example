DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_AUCTION_CHANNEL_ID=your_auction_channel_id

# Exact SPA origin (no trailing slash). Required for OAuth redirect + CORS.
# Local Vite uses port 3000; production = your Vercel URL (e.g. https://your-app.vercel.app).
FRONTEND_URL=http://localhost:3000

# Must match Discord Developer Portal redirect + Render public URL
OAUTH_REDIRECT_URI=http://localhost:5001/auth/callback

# Production: token exchange runs on Vercel (FRONTEND_URL/api/discord-token-exchange)
# using DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET from Render — not from Vercel env.
# Optional override:
# OAUTH_EXCHANGE_URL=https://your-app.vercel.app/api/discord-token-exchange

SESSION_SECRET=your_session_secret
SETTINGS_MASTER_KEY=your_settings_unlock_passphrase

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Legacy Google Sheets (unused — syncRouter is not mounted). Safe to omit.
# GOOGLE_SHEETS_SPREADSHEET_ID=

# 🛡️ Foundational Attendance Environment Channels Map
DISCORD_AUCREQ_CHANNEL_ID=your_auction_signup_lobby_channel_id
DISCORD_GENROOM_ID_1=your_bot_commands_chat_channel_id
# Legacy weekly attendance thread channel (no longer auto-posted)
DISCORD_ATTENDANCE_ID=your_attendance_channel_id
# Per-event Attendance card (Confirm / Leave ephemeral)
DISCORD_WARANNOUNCE_CHANNEL_ID=your_war_announce_channel_id
DISCORD_WARROOM_ID_1=your_raid_voice_room_1_snowflake_id
DISCORD_WARROOM_ID_2=your_raid_voice_room_2_snowflake_id
DISCORD_WARROOM_ID_3=your_raid_voice_room_3_snowflake_id
DISCORD_WARROOM_ID_4=your_raid_voice_room_4_snowflake_id
DISCORD_WARROOM_ID_5=your_raid_voice_room_5_snowflake_id
